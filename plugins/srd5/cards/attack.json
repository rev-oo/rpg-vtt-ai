{
  "$schema": "../../../packages/plugin-schema/schemas/card.schema.json",
  "title": "card.attack",
  "rows": [
    {
      "label": "card.weapon",
      "value": "@item.name"
    },
    {
      "label": "card.attackRoll",
      "value": "@rolls.attack.resolved"
    },
    {
      "label": "card.total",
      "value": "@rolls.attack.total",
      "class": "total"
    },
    {
      "label": "card.damage",
      "value": "@rolls.damage.resolved"
    },
    {
      "label": "card.damageTotal",
      "value": "@rolls.damage.total",
      "class": "total"
    },
    {
      "label": "card.damageType",
      "value": "'damage.' + @item.damageType"
    }
  ],
  "outcome": true,
  "actions": [
    {
      "label": "card.applyDamage",
      "field": "hp.value",
      "amount": "-@rolls.damage.total"
    },
    {
      "label": "card.applyHalf",
      "field": "hp.value",
      "amount": "-floor(@rolls.damage.total / 2)"
    }
  ]
}
