{
  "$schema": "../../../packages/plugin-schema/schemas/card.schema.json",
  "title": "card.attack",
  "rows": [
    {
      "label": "card.weapon",
      "value": "@item.name"
    },
    {
      "label": "card.attackRoll",
      "value": "@rolls.attack.resolved"
    },
    {
      "label": "card.total",
      "value": "@rolls.attack.total",
      "class": "total"
    }
  ],
  "outcome": true,
  "actions": [
    {
      "label": "card.rollDamage",
      "roll": "weaponDamage",
      "for": "roller",
      "args": {
        "crit": "@rolls.attack.natural >= @critRange"
      },
      "when": "@rolls.attack.natural != 1"
    }
  ]
}
