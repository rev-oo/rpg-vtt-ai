{
  "$schema": "../../../packages/plugin-schema/schemas/card.schema.json",
  "title": "card.npcAttack",
  "rows": [
    {
      "label": "card.action",
      "value": "@actions[@args.id].name"
    },
    {
      "label": "card.attackRoll",
      "value": "@rolls.attack.resolved"
    },
    {
      "label": "card.total",
      "value": "@rolls.attack.total",
      "class": "total"
    },
    {
      "label": "card.damage",
      "value": "@rolls.damage.resolved + ' ' + @actions[@args.id].damageType"
    },
    {
      "label": "card.damageTotal",
      "value": "@rolls.damage.total",
      "class": "total"
    }
  ],
  "outcome": true
}
