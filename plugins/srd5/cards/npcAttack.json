{
  "$schema": "../../../packages/plugin-schema/schemas/card.schema.json",
  "title": "card.npcAttack",
  "rows": [
    {
      "label": "card.action",
      "value": "@actions[@args.id].name"
    },
    {
      "label": "card.attackRoll",
      "value": "@rolls.attack.resolved"
    },
    {
      "label": "card.total",
      "value": "@rolls.attack.total",
      "class": "total"
    }
  ],
  "outcome": true,
  "actions": [
    {
      "label": "card.rollDamage",
      "roll": "npcDamage",
      "for": "roller",
      "args": {
        "crit": "@rolls.attack.natural == 20",
        "id": "@args.id"
      },
      "when": "@rolls.attack.natural != 1"
    }
  ]
}
