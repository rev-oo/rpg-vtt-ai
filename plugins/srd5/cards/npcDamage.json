{
  "$schema": "../../../packages/plugin-schema/schemas/card.schema.json",
  "title": "card.npcDamage",
  "rows": [
    {
      "label": "card.action",
      "value": "@actions[@args.id].name"
    },
    {
      "label": "card.damage",
      "value": "@roll.resolved"
    },
    {
      "label": "card.damageTotal",
      "value": "@total",
      "class": "total"
    },
    {
      "label": "card.damageType",
      "value": "'damage.' + @actions[@args.id].damageType"
    }
  ],
  "outcome": true,
  "actions": [
    {
      "label": "card.applyDamage",
      "field": "hp.value",
      "amount": "-@total"
    },
    {
      "label": "card.applyHalf",
      "field": "hp.value",
      "amount": "-floor(@total / 2)"
    }
  ]
}
