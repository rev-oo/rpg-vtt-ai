{
  "$schema": "../../../packages/plugin-schema/schemas/card.schema.json",
  "title": "card.spell",
  "rows": [
    {
      "label": "card.spellName",
      "value": "@item.name"
    },
    {
      "label": "card.spellLevel",
      "value": "@options.slot"
    },
    {
      "label": "card.roll",
      "value": "@roll.resolved"
    },
    {
      "label": "card.total",
      "value": "@total",
      "class": "total"
    },
    {
      "label": "card.save",
      "value": "@item.attack == 'spell.save' ? @item.save : '—'"
    },
    {
      "label": "card.saveDc",
      "value": "@item.attack == 'spell.save' ? @derived.spellDc : '—'"
    },
    {
      "label": "card.damageType",
      "value": "'damage.' + @item.effectType"
    }
  ],
  "outcome": true,
  "actions": [
    {
      "label": "card.rollDamage",
      "roll": "spellDamage",
      "for": "roller",
      "args": {
        "crit": "@roll.natural >= @critRange",
        "slot": "@options.slot"
      },
      "when": "not @let.effect and @item.dice > 0 and @roll.natural != 1"
    },
    {
      "label": "card.rollSave",
      "roll": "save",
      "args": {
        "ability": "@item.save",
        "dc": "@derived.spellDc"
      },
      "when": "@item.attack == 'spell.save'"
    },
    {
      "label": "card.applyDamage",
      "field": "hp.value",
      "amount": "-@total",
      "when": "@let.effect and @item.effectType != 'healing' and @item.effectType != 'none'"
    },
    {
      "label": "card.applyHalf",
      "field": "hp.value",
      "amount": "-floor(@total / 2)",
      "when": "@let.effect and @item.effectType != 'healing' and @item.effectType != 'none'"
    },
    {
      "label": "card.applyHealing",
      "field": "hp.value",
      "amount": "@total",
      "when": "@let.effect and @item.effectType == 'healing'"
    }
  ]
}
