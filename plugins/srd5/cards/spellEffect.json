{
  "$schema": "../../../packages/plugin-schema/schemas/card.schema.json",
  "title": "card.spell",
  "rows": [
    {
      "label": "card.spellName",
      "value": "@item.name"
    },
    {
      "label": "card.spellLevel",
      "value": "@options.slot"
    },
    {
      "label": "card.roll",
      "value": "@roll.resolved"
    },
    {
      "label": "card.total",
      "value": "@total",
      "class": "total"
    },
    {
      "label": "card.save",
      "value": "@item.attack == 'spell.save' ? @item.save : '—'"
    },
    {
      "label": "card.saveDc",
      "value": "@item.attack == 'spell.save' ? @derived.spellDc : '—'"
    },
    {
      "label": "card.damageType",
      "value": "'damage.' + @item.effectType"
    }
  ],
  "outcome": true,
  "apply": [
    {
      "label": "card.applyEffect",
      "field": "hp.value",
      "amount": "@item.effectType == 'healing' ? @total : -@total"
    },
    {
      "label": "card.applyHalf",
      "field": "hp.value",
      "amount": "@item.effectType == 'healing' ? floor(@total / 2) : -floor(@total / 2)"
    }
  ]
}
