{
  "$schema": "../../packages/plugin-schema/schemas/rolls.schema.json",
  "check_str": {
    "label": "roll.check.str",
    "options": {
      "mode": {
        "type": "choice",
        "label": "option.mode",
        "choices": [
          {
            "value": "normal",
            "label": "mode.normal"
          },
          {
            "value": "advantage",
            "label": "mode.advantage",
            "key": "shift"
          },
          {
            "value": "disadvantage",
            "label": "mode.disadvantage",
            "key": "ctrl"
          }
        ]
      },
      "bonus": {
        "type": "dice",
        "label": "option.bonus"
      }
    },
    "let": {
      "edge": "((@options.mode == 'advantage' or @derived.checkAdv) ? 1 : 0) - ((@options.mode == 'disadvantage' or @derived.checkDis) ? 1 : 0)"
    },
    "formula": "(@let.edge == 0 ? 1d20 : @let.edge > 0 ? 2d20kh1 : 2d20kl1) + @derived.strCheck + roll(@options.bonus)"
  },
  "save_str": {
    "label": "roll.save.str",
    "options": {
      "mode": {
        "type": "choice",
        "label": "option.mode",
        "choices": [
          {
            "value": "normal",
            "label": "mode.normal"
          },
          {
            "value": "advantage",
            "label": "mode.advantage",
            "key": "shift"
          },
          {
            "value": "disadvantage",
            "label": "mode.disadvantage",
            "key": "ctrl"
          }
        ]
      },
      "bonus": {
        "type": "dice",
        "label": "option.bonus"
      }
    },
    "let": {
      "edge": "((@options.mode == 'advantage') ? 1 : 0) - ((@options.mode == 'disadvantage') ? 1 : 0)"
    },
    "formula": "(@let.edge == 0 ? 1d20 : @let.edge > 0 ? 2d20kh1 : 2d20kl1) + @derived.strSave + roll(@options.bonus)",
    "outcomes": [
      {
        "when": "@conditions.paralyzed or @conditions.stunned or @conditions.unconscious or @conditions.petrified",
        "label": "outcome.autoFail",
        "class": "fail"
      }
    ]
  },
