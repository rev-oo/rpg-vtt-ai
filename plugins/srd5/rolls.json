        "label": "option.bonus"
      }
    },
    "let": {
      "edge": "((@options.mode == 'advantage' or @derived.attackAdv) ? 1 : 0) - ((@options.mode == 'disadvantage' or @derived.attackDis) ? 1 : 0)",
      "mod": "@item.ranged ? @derived.dexMod : @item.finesse ? max(@derived.strMod, @derived.dexMod) : @derived.strMod",
      "toHit": "@let.mod + (@item.proficient ? @derived.prof : 0) + @item.magic - @derived.d20Penalty"
    },
    "formula": {
      "attack": "(@let.edge == 0 ? 1d20 : @let.edge > 0 ? 2d20kh1 : 2d20kl1) + @let.toHit + roll(@options.bonus)",
      "damage": "(@rolls.attack.natural >= @critRange ? @item.dice * 2 : @item.dice)d(@item.derived.die) + @let.mod + @item.magic + roll(@item.extraDamage, @rolls.attack.natural >= @critRange ? 2 : 1)"
    },
