{
  "$schema": "../../packages/plugin-schema/schemas/rolls.schema.json",
  "check_str": {
    "label": "roll.check.str",
    "formula": "(@derived.checkEdge == 0 ? 1d20 : @derived.checkEdge > 0 ? 2d20kh1 : 2d20kl1) + @derived.strCheck"
  },
  "save_str": {
    "label": "roll.save.str",
    "formula": "(@derived.saveEdge == 0 ? 1d20 : @derived.saveEdge > 0 ? 2d20kh1 : 2d20kl1) + @derived.strSave",
    "outcomes": [
      {
        "when": "@conditions.paralyzed or @conditions.stunned or @conditions.unconscious or @conditions.petrified",
        "label": "outcome.autoFail",
        "class": "fail"
      }
    ]
  },
