    "formula": "(@derived.checkEdge == 0 ? 1d20 : @derived.checkEdge > 0 ? 2d20kh1 : 2d20kl1) + @derived.persuasion"
  },
  "skill_religion": {
    "label": "roll.skill.religion",
    "formula": "(@derived.checkEdge == 0 ? 1d20 : @derived.checkEdge > 0 ? 2d20kh1 : 2d20kl1) + @derived.religion"
  },
  "skill_sleightOfHand": {
    "label": "roll.skill.sleightOfHand",
    "formula": "(@derived.checkEdge == 0 ? 1d20 : @derived.checkEdge > 0 ? 2d20kh1 : 2d20kl1) + @derived.sleightOfHand"
  },
  "skill_stealth": {
    "label": "roll.skill.stealth",
    "formula": "(@derived.checkEdge == 0 ? 1d20 : @derived.checkEdge > 0 ? 2d20kh1 : 2d20kl1) + @derived.stealth"
  },
  "skill_survival": {
    "label": "roll.skill.survival",
    "formula": "(@derived.checkEdge == 0 ? 1d20 : @derived.checkEdge > 0 ? 2d20kh1 : 2d20kl1) + @derived.survival"
  },
  "weaponAttack": {
    "label": "roll.weaponAttack",
    "formula": "(@derived.attackEdge == 0 ? 1d20 : @derived.attackEdge > 0 ? 2d20kh1 : 2d20kl1) + (@item.ranged ? @derived.dexMod : @item.finesse ? max(@derived.strMod, @derived.dexMod) : @derived.strMod) + (@item.proficient ? @derived.prof : 0) + @item.magic - @derived.d20Penalty",
    "outcomes": [
      {
        "when": "@total - ((@item.ranged ? @derived.dexMod : @item.finesse ? max(@derived.strMod, @derived.dexMod) : @derived.strMod) + (@item.proficient ? @derived.prof : 0) + @item.magic - @derived.d20Penalty) == 20",
        "label": "outcome.crit",
        "class": "crit"
      },
      {
        "when": "@total - ((@item.ranged ? @derived.dexMod : @item.finesse ? max(@derived.strMod, @derived.dexMod) : @derived.strMod) + (@item.proficient ? @derived.prof : 0) + @item.magic - @derived.d20Penalty) == 1",
        "label": "outcome.fumble",
        "class": "fail"
      }
    ],
    "card": "attack",
    "item": ["weapon"]
  },
  "weaponDamage": {
    "label": "roll.weaponDamage",
    "formula": "(@item.dice)d(@item.derived.die) + (@item.ranged ? @derived.dexMod : @item.finesse ? max(@derived.strMod, @derived.dexMod) : @derived.strMod) + @item.magic + roll(@item.extraDamage)",
    "card": "damage",
    "item": ["weapon"]
  },
  "weaponCrit": {
    "label": "roll.weaponCrit",
    "formula": "(@item.dice * 2)d(@item.derived.die) + (@item.ranged ? @derived.dexMod : @item.finesse ? max(@derived.strMod, @derived.dexMod) : @derived.strMod) + @item.magic + roll(@item.extraDamage, 2)",
    "card": "damage",
    "item": ["weapon"]
  },
  "unarmedAttack": {
    "label": "roll.unarmedAttack",
    "formula": "(@derived.attackEdge == 0 ? 1d20 : @derived.attackEdge > 0 ? 2d20kh1 : 2d20kl1) + @derived.strMod + @derived.prof - @derived.d20Penalty",
    "outcomes": [
      {
        "when": "@total - (@derived.strMod + @derived.prof - @derived.d20Penalty) == 20",
        "label": "outcome.crit",
        "class": "crit"
      },
      {
        "when": "@total - (@derived.strMod + @derived.prof - @derived.d20Penalty) == 1",
        "label": "outcome.fumble",
        "class": "fail"
      }
    ]
  },
  "unarmedDamage": {
    "label": "roll.unarmedDamage",
    "formula": "max(0, 1 + @derived.strMod)"
  },
  "spellCast": {
    "label": "roll.spellCast",
    "formula": "@item.attack == 'spell.attack' ? (@derived.attackEdge == 0 ? 1d20 : @derived.attackEdge > 0 ? 2d20kh1 : 2d20kl1) + @derived.spellAttack : ((@item.level == 0 ? @item.dice * @derived.cantripDice : @item.dice))d(@item.die) + (@item.addMod ? @derived.spellMod : 0) + @item.bonus",
    "outcomes": [
      {
        "when": "@item.attack == 'spell.attack' and @total - @derived.spellAttack == 20",
        "label": "outcome.crit",
        "class": "crit"
      },
      {
        "when": "@item.attack == 'spell.attack' and @total - @derived.spellAttack == 1",
        "label": "outcome.fumble",
        "class": "fail"
      }
    ],
    "card": "spell",
    "item": ["spell"]
  },
  "spellEffect": {
    "label": "roll.spellEffect",
    "formula": "((@item.level == 0 ? @item.dice * @derived.cantripDice : @item.dice))d(@item.die) + (@item.addMod ? @derived.spellMod : 0) + @item.bonus",
    "card": "spell",
    "item": ["spell"]
  },
  "deathSave": {
    "label": "roll.deathSave",
    "handler": "deathSave"
  },
  "shortRest": {
    "label": "roll.shortRest",
    "handler": "spendHitDie"
  },
  "longRest": {
    "label": "roll.longRest",
    "handler": "longRest"
  },
  "npcAttack": {
    "label": "roll.npcAttack",
    "formula": "(@derived.attackEdge == 0 ? 1d20 : @derived.attackEdge > 0 ? 2d20kh1 : 2d20kl1) + @actions[@args.id].bonus - @derived.d20Penalty",
    "outcomes": [
      {
        "when": "@total - (@actions[@args.id].bonus - @derived.d20Penalty) == 20",
        "label": "outcome.crit",
        "class": "crit"
      },
      {
        "when": "@total - (@actions[@args.id].bonus - @derived.d20Penalty) == 1",
        "label": "outcome.fumble",
        "class": "fail"
      }
    ],
    "card": "npcAttack"
  },
  "npcDamage": {
    "label": "roll.npcDamage",
    "formula": "(@actions[@args.id].dice)d(@actions[@args.id].die) + @actions[@args.id].damageBonus + roll(@actions[@args.id].extraDamage)",
    "card": "npcDamage"
  },
  "npcCrit": {
    "label": "roll.npcCrit",
    "formula": "(@actions[@args.id].dice * 2)d(@actions[@args.id].die) + @actions[@args.id].damageBonus + roll(@actions[@args.id].extraDamage, 2)",
    "card": "npcDamage"
  }
}
