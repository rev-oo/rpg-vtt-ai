{
  "$schema": "../../../packages/plugin-schema/schemas/card.schema.json",
  "title": "card.attack",
  "rows": [
    {
      "label": "card.weapon",
      "value": "@item.name"
    },
    {
      "label": "card.roll",
      "value": "@roll.resolved"
    },
    {
      "label": "card.total",
      "value": "@total",
      "class": "total"
    },
    {
      "label": "card.onHit",
      "value": "damage(@item.dice, @item.derived.die, (@item.ranged ? @derived.dexMod : @item.finesse ? max(@derived.strMod, @derived.dexMod) : @derived.strMod) + @item.magic) + ' ' + @item.damageType"
    }
  ],
  "outcome": true
}
