    {
      "id": "fire-bolt",
      "kind": "item",
      "type": "spell",
      "name": "Fire Bolt",
      "data": {
        "level": 0,
        "school": "school.evocation",
        "castingTime": "Action",
        "range": "120 feet",
        "components": "V, S",
        "duration": "Instantaneous",
        "attack": "spell.attack",
        "dice": 1,
        "die": 10,
        "effectType": "fire",
        "description": "Make a ranged spell attack against a creature or object within range. On a hit, the target takes 1d10 Fire damage. A flammable object hit by this spell starts burning if it isn’t being worn or carried.",
        "higherLevels": "Cantrip upgrade: one more die at levels 5 (2d10), 11 (3d10) and 17 (4d10)."
      }
    },
    {
      "id": "sacred-flame",
      "kind": "item",
      "type": "spell",
      "name": "Sacred Flame",
      "data": {
        "level": 0,
        "school": "school.evocation",
        "castingTime": "Action",
        "range": "60 feet",
        "components": "V, S",
        "duration": "Instantaneous",
        "attack": "spell.save",
        "save": "ability.dex",
        "dice": 1,
        "die": 8,
        "effectType": "radiant",
        "description": "Flame-like radiance descends on a creature that you can see within range. The target must succeed on a Dexterity saving throw or take 1d8 Radiant damage. The target gains no benefit from Half Cover or Three-Quarters Cover for this save.",
        "higherLevels": "Cantrip upgrade: one more die at levels 5 (2d8), 11 (3d8) and 17 (4d8)."
      }
    },
    {
      "id": "ray-of-frost",
      "kind": "item",
      "type": "spell",
      "name": "Ray of Frost",
      "data": {
        "level": 0,
        "school": "school.evocation",
        "castingTime": "Action",
        "range": "60 feet",
        "components": "V, S",
        "duration": "Instantaneous",
        "attack": "spell.attack",
        "dice": 1,
        "die": 8,
        "effectType": "cold",
        "description": "A frigid beam of blue-white light streaks toward a creature within range. Make a ranged spell attack against the target. On a hit, it takes 1d8 Cold damage, and its Speed is reduced by 10 feet until the start of your next turn.",
        "higherLevels": "Cantrip upgrade: one more die at levels 5 (2d8), 11 (3d8) and 17 (4d8)."
      }
    },
    {
      "id": "magic-missile",
      "kind": "item",
      "type": "spell",
      "name": "Magic Missile",
      "data": {
        "level": 1,
        "school": "school.evocation",
        "castingTime": "Action",
        "range": "120 feet",
        "components": "V, S",
        "duration": "Instantaneous",
        "dice": 3,
        "die": 4,
        "bonus": 3,
        "effectType": "force",
        "description": "You create three glowing darts of magical force. Each dart strikes a creature of your choice that you can see within range. A dart deals 1d4 + 1 Force damage to its target. The darts all strike simultaneously. (The effect roll is all three darts at one target.)",
        "higherLevels": "One more dart for each spell slot level above 1."
      }
    },
    {
      "id": "cure-wounds",
      "kind": "item",
      "type": "spell",
      "name": "Cure Wounds",
      "data": {
        "level": 1,
        "school": "school.abjuration",
        "castingTime": "Action",
        "range": "Touch",
        "components": "V, S",
        "duration": "Instantaneous",
        "dice": 2,
        "die": 8,
        "addMod": true,
        "effectType": "healing",
        "description": "A creature you touch regains a number of Hit Points equal to 2d8 plus your spellcasting ability modifier.",
        "higherLevels": "The healing increases by 2d8 for each spell slot level above 1."
      }
    },
    {
      "id": "healing-word",
      "kind": "item",
      "type": "spell",
      "name": "Healing Word",
      "data": {
        "level": 1,
        "school": "school.abjuration",
        "castingTime": "Bonus Action",
        "range": "60 feet",
        "components": "V",
        "duration": "Instantaneous",
        "dice": 2,
        "die": 4,
        "addMod": true,
        "effectType": "healing",
        "description": "A creature of your choice that you can see within range regains Hit Points equal to 2d4 plus your spellcasting ability modifier.",
        "higherLevels": "The healing increases by 2d4 for each spell slot level above 1."
      }
    },
    {
      "id": "shield-spell",
      "kind": "item",
      "type": "spell",
      "name": "Shield",
      "data": {
        "level": 1,
        "school": "school.abjuration",
        "castingTime": "Reaction",
        "range": "Self",
        "components": "V, S",
        "duration": "1 round",
        "description": "Casting time: a Reaction, which you take when you are hit by an attack roll or targeted by the Magic Missile spell. An imperceptible barrier of magical force protects you. Until the start of your next turn, you have a +5 bonus to AC, including against the triggering attack, and you take no damage from Magic Missile."
      }
    },
    {
      "id": "burning-hands",
      "kind": "item",
      "type": "spell",
      "name": "Burning Hands",
      "data": {
        "level": 1,
        "school": "school.evocation",
        "castingTime": "Action",
        "range": "Self (15-foot Cone)",
        "components": "V, S",
        "duration": "Instantaneous",
        "attack": "spell.save",
        "save": "ability.dex",
        "dice": 3,
        "die": 6,
        "effectType": "fire",
        "description": "A thin sheet of flames shoots forth from you. Each creature in a 15-foot Cone makes a Dexterity saving throw, taking 3d6 Fire damage on a failed save or half as much damage on a successful one.",
        "higherLevels": "The damage increases by 1d6 for each spell slot level above 1."
      }
    },
    {
      "id": "thunderwave",
      "kind": "item",
      "type": "spell",
      "name": "Thunderwave",
      "data": {
        "level": 1,
        "school": "school.evocation",
        "castingTime": "Action",
        "range": "Self (15-foot Cube)",
        "components": "V, S",
        "duration": "Instantaneous",
        "attack": "spell.save",
        "save": "ability.con",
        "dice": 2,
        "die": 8,
        "effectType": "thunder",
        "description": "You unleash a wave of thunderous energy. Each creature in a 15-foot Cube originating from you makes a Constitution saving throw. On a failed save, a creature takes 2d8 Thunder damage and is pushed 10 feet away from you. On a successful save, a creature takes half as much damage only.",
        "higherLevels": "The damage increases by 1d8 for each spell slot level above 1."
      }
    },
    {
      "id": "bless",
      "kind": "item",
      "type": "spell",
      "name": "Bless",
      "data": {
        "level": 1,
        "school": "school.enchantment",
        "castingTime": "Action",
        "range": "30 feet",
        "components": "V, S, M (a Holy Symbol worth 5+ GP)",
        "duration": "Concentration, up to 1 minute",
        "concentration": true,
        "description": "You bless up to three creatures within range. Whenever a target makes an attack roll or a saving throw before the spell ends, the target adds 1d4 to the attack roll or save.",
        "higherLevels": "You can target one additional creature for each spell slot level above 1."
      }
    },
    {
      "id": "scorching-ray",
      "kind": "item",
