{
  "$schema": "../../packages/plugin-schema/schemas/settings.schema.json",
  "colour": {
    "type": "string",
    "default": "ivory",
    "enum": ["ivory", "crimson", "sapphire", "emerald", "onyx"],
    "label": "setting.colour",
    "scope": "user"
  },
  "seconds": {
    "type": "number",
    "default": 3,
    "minimum": 1,
    "maximum": 10,
    "label": "setting.seconds",
    "description": "setting.secondsHint",
    "scope": "user"
  },
  "maxDice": {
    "type": "integer",
    "default": 20,
    "minimum": 1,
    "maximum": 30,
    "label": "setting.maxDice",
    "description": "setting.maxDiceHint",
    "scope": "instance"
  },
  "showOthers": {
    "type": "boolean",
    "default": true,
    "label": "setting.showOthers",
    "scope": "user"
  }
}
