{
  "$schema": "../../packages/plugin-schema/schemas/settings.schema.json",
  "rolls": {
    "type": "string",
    "default": "rolls.all",
    "enum": ["rolls.all", "rolls.mine"],
    "label": "setting.rolls",
    "scope": "user"
  },
  "diceColour": {
    "type": "string",
    "default": "#8b1e2d",
    "maxLength": 30,
    "label": "setting.diceColour",
    "description": "setting.colour.help",
    "scope": "user"
  },
  "numberColour": {
    "type": "string",
    "default": "#f6efe3",
    "maxLength": 30,
    "label": "setting.numberColour",
    "description": "setting.colour.help",
    "scope": "user"
  },
  "size": {
    "type": "number",
    "default": 1,
    "minimum": 0.5,
    "maximum": 2,
    "label": "setting.size",
    "scope": "user"
  },
  "stay": {
    "type": "integer",
    "default": 3,
    "minimum": 1,
    "maximum": 30,
    "label": "setting.stay",
    "scope": "user"
  }
}
