{
  "title": "Custom dice (dice.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "label": {
        "description": "The die name; a lang key or literal text.",
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "title": "Text"
      },
      "faces": {
        "minItems": 1,
        "maxItems": 1000,
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20
            },
            {
              "type": "number"
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 20
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false,
              "title": "Face"
            }
          ]
        },
        "description": "Equally likely faces: a label, a number, or `{ label, value }`."
      },
      "values": {
        "description": "What text faces count as, such as `{ \"-\": -1, \" \": 0, \"+\": 1 }` for Fate.",
        "type": "object",
        "propertyNames": {
          "type": "string",
          "maxLength": 20
        },
        "additionalProperties": {
          "type": "number"
        }
      }
    },
    "required": [
      "faces"
    ],
    "additionalProperties": false,
    "title": "Die"
  },
  "description": "Custom dice by name: `d` and capitals or digits, such as `dF`."
}
