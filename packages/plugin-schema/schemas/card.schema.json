{
  "title": "Chat card (cards/<name>.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "A formula (specs §8.9)."
          },
          "class": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "rows"
  ],
  "additionalProperties": false
}
