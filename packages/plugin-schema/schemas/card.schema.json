{
  "title": "Chat card (cards/<name>.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "title": "Text",
      "description": "A lang key or literal text."
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text",
            "description": "A lang key or literal text."
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "title": "Formula",
            "description": "Reads `@total`, `@roll.expression`, `@roll.resolved` and the entity's data. It cannot roll dice."
          },
          "class": {
            "type": "string",
            "maxLength": 200,
            "title": "CSS classes"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false,
        "title": "Card row"
      }
    },
    "outcome": {
      "description": "Shows the recipe's outcome.",
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "rows"
  ],
  "additionalProperties": false,
  "description": "How a recipe roll shows in chat."
}
