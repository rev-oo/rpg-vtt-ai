{
  "title": "Item type (types/items/<type>.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "title": "Text",
      "description": "The type name players see; a lang key or literal text."
    },
    "sheet": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Name",
      "description": "The sheet in `sheets/`, without `.json`."
    },
    "schema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Identifier"
          }
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "type",
        "properties"
      ],
      "additionalProperties": false,
      "title": "Data schema",
      "description": "The entity's data: an object whose properties are fields."
    },
    "derived": {
      "description": "Values computed from the data and never stored, by name. Formulas read them as `@derived.<name>`.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "title": "Identifier"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "title": "Formula",
        "description": "A formula (specs §8.9)."
      }
    },
    "labelPlural": {
      "description": "The type name for a list of them, such as \"Weapons\"; a lang key or literal text. It heads the type’s items when the type has no `group`.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "title": "Text"
    },
    "group": {
      "description": "The heading item lists show this type under, such as \"Spells\" or \"Gear\"; a lang key or literal text. Types with the same group share it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "title": "Text"
    },
    "order": {
      "description": "Where its group comes in item lists: lowest first, then by heading. A group takes the lowest `order` of its types. Default 0.",
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    }
  },
  "required": [
    "label",
    "sheet",
    "schema"
  ],
  "additionalProperties": false,
  "description": "An item type, such as a weapon or a spell.",
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "object",
            "array"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "default": {
          "description": "The value new entities start with; it must fit the field."
        },
        "enum": {
          "description": "The allowed values; a `select` input offers them.",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Identifier"
          }
        },
        "properties": {
          "description": "The fields of an `object`, by name.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "items": {
          "description": "The rows of an `array`; an `object` for a collection.",
          "$ref": "#/$defs/__schema0"
        },
        "x-kind": {
          "description": "How the core stores and edits the field: `longText` and `richText` are shared text that several people edit at once, `collection` is a list of rows with ids, `image` is a picture URL.",
          "type": "string",
          "enum": [
            "longText",
            "collection",
            "richText",
            "image"
          ]
        },
        "x-counter": {
          "description": "A number changed in steps; steps from several people at once add up instead of overwriting each other.",
          "type": "boolean"
        },
        "x-layer": {
          "description": "Only the GM and assistants see the field; it never reaches players.",
          "type": "string",
          "const": "secret"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "title": "Field"
    }
  }
}
