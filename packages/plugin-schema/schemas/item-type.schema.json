{
  "title": "Item type (types/items/<type>.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sheet": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "schema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "type",
        "properties"
      ],
      "additionalProperties": false
    },
    "derived": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "description": "A formula (specs §8.9)."
      }
    }
  },
  "required": [
    "label",
    "sheet",
    "schema"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "object",
            "array"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "default": {},
        "enum": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "items": {
          "$ref": "#/$defs/__schema0"
        },
        "x-kind": {
          "type": "string",
          "enum": [
            "longText",
            "collection",
            "richText",
            "image"
          ]
        },
        "x-counter": {
          "type": "boolean"
        },
        "x-layer": {
          "type": "string",
          "const": "secret"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
