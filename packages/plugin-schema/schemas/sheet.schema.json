{
  "title": "Sheet layout (sheets/<name>.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "layout": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "layout"
  ],
  "additionalProperties": false,
  "description": "A sheet layout: a tree of nodes. Types name their sheet in `sheet`.",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "row"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "description": "The nodes inside, in order."
                },
                "gap": {
                  "description": "The space between children.",
                  "type": "string",
                  "enum": [
                    "none",
                    "sm",
                    "md",
                    "lg"
                  ]
                },
                "wrap": {
                  "description": "Wraps children onto more lines when narrow.",
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "children"
              ],
              "additionalProperties": false,
              "description": "Lays its children out side by side."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "column"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "description": "The nodes inside, in order."
                },
                "gap": {
                  "description": "The space between children.",
                  "type": "string",
                  "enum": [
                    "none",
                    "sm",
                    "md",
                    "lg"
                  ]
                }
              },
              "required": [
                "type",
                "children"
              ],
              "additionalProperties": false,
              "description": "Stacks its children."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "grid"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "description": "The nodes inside, in order."
                },
                "columns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12,
                  "description": "Columns on wide screens; phones show one."
                }
              },
              "required": [
                "type",
                "children",
                "columns"
              ],
              "additionalProperties": false,
              "description": "Lays its children out in columns."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "tabs"
                },
                "tabs": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "title": "Text",
                        "description": "The tab title."
                      },
                      "children": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "description": "The nodes inside, in order."
                      }
                    },
                    "required": [
                      "label",
                      "children"
                    ],
                    "additionalProperties": false,
                    "title": "Tab"
                  }
                }
              },
              "required": [
                "type",
                "tabs"
              ],
              "additionalProperties": false,
              "description": "Shows one tab at a time."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "section"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text",
                  "description": "The heading; a lang key or literal text."
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "description": "The nodes inside, in order."
                },
                "collapsible": {
                  "description": "Lets the viewer fold it away.",
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "title",
                "children"
              ],
              "additionalProperties": false,
              "description": "A titled group."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "field"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
                  "title": "Path",
                  "description": "The field, as a dot path such as `hp.value`."
                },
                "label": {
                  "description": "A lang key or literal text; defaults to the field's path.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text"
                },
                "input": {
                  "description": "The control: `text` (the default), `number`, `checkbox` (boolean fields), `select` (fields with `enum`) or `counter` (− and + buttons).",
                  "type": "string",
                  "enum": [
                    "text",
                    "number",
                    "checkbox",
                    "select",
                    "counter"
                  ]
                }
              },
              "required": [
                "type",
                "path"
              ],
              "additionalProperties": false,
              "description": "Edits one field, and shows who else is in it."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "longText"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
                  "title": "Path",
                  "description": "A `longText` or `richText` field."
                },
                "label": {
                  "description": "A lang key or literal text; defaults to the field's path.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text"
                }
              },
              "required": [
                "type",
                "path"
              ],
              "additionalProperties": false,
              "description": "A text box several people can type into at once; rich text gets a toolbar."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "list"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
                  "title": "Path",
                  "description": "An `array` field."
                },
                "item": {
                  "$ref": "#/$defs/__schema0"
                },
                "addLabel": {
                  "description": "The text of the add button.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text"
                }
              },
              "required": [
                "type",
                "path",
                "item"
              ],
              "additionalProperties": false,
              "description": "The rows of an array, with add, remove and reorder. `item` is one row's layout; its paths are relative to the row."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "items"
                },
                "itemTypes": {
                  "description": "The item types to list; every type when left out.",
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
                    "title": "Name"
                  }
                },
                "item": {
                  "$ref": "#/$defs/__schema0"
                },
                "addLabel": {
                  "description": "The text of the add button.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text"
                }
              },
              "required": [
                "type",
                "item"
              ],
              "additionalProperties": false,
              "description": "The actor's items, grouped, each edited in place, with open, remove and add (actor sheets only). `item` is one item's layout: its paths are relative to the item's data, and `@item.id`, `@item.name` and `@item.type` name the item."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "rollButton"
                },
                "roll": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
                  "title": "Name",
                  "description": "A recipe in `rolls.json`."
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text",
                  "description": "The button's text."
                },
                "args": {
                  "description": "Values the recipe reads as `@args.<name>`: formulas, numbers or true/false. In a list, `\"@row.id\"` names the row.",
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                    "title": "Identifier"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "title": "Formula",
                        "description": "A formula (specs §8.9)."
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "type",
                "roll",
                "label"
              ],
              "additionalProperties": false,
              "description": "Rolls a recipe for the entity and posts it to chat."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "derived"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "title": "Identifier",
                  "description": "A name in the type's `derived`."
                },
                "label": {
                  "description": "A lang key or literal text; defaults to the key.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text"
                },
                "format": {
                  "description": "`integer` rounds, `signed` rounds and shows `+2` or `−1`, `decimal` keeps two places.",
                  "type": "string",
                  "enum": [
                    "integer",
                    "signed",
                    "decimal"
                  ]
                }
              },
              "required": [
                "type",
                "key"
              ],
              "additionalProperties": false,
              "description": "Shows a derived value."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "image"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
                  "title": "Path",
                  "description": "A string field holding the picture URL."
                },
                "size": {
                  "description": "Defaults to `md`.",
                  "type": "string",
                  "enum": [
                    "sm",
                    "md",
                    "lg"
                  ]
                }
              },
              "required": [
                "type",
                "path"
              ],
              "additionalProperties": false,
              "description": "Shows the picture of an image field. Those who may edit the sheet click it to pick another, or to remove it."
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "description": "Extra CSS classes, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                },
                "visibleIf": {
                  "description": "Shows the node only while this formula is true. It cannot roll dice.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "type": {
                  "type": "string",
                  "const": "text"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text",
                  "description": "A lang key or literal text."
                }
              },
              "required": [
                "type",
                "text"
              ],
              "additionalProperties": false,
              "description": "Static text."
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "class": {
              "description": "Extra CSS classes, for `styles/*.css`.",
              "type": "string",
              "maxLength": 200,
              "title": "CSS classes"
            },
            "visibleIf": {
              "description": "Shows the node only while this formula is true. It cannot roll dice.",
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "title": "Formula"
            },
            "type": {
              "type": "string",
              "pattern": "^custom:[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "props": {
              "description": "Any JSON, passed to the component as `props`.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "title": "Node `custom:<name>`",
          "description": "A component from the plugin's `code/client`, by its name in `nodes`."
        }
      ],
      "title": "Node"
    }
  }
}
