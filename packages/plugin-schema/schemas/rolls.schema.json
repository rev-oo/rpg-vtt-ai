{
  "title": "Roll recipes (rolls.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "label": {
            "description": "The roll name in chat; a lang key or literal text.",
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text"
          },
          "let": {
            "description": "Named values worked out before rolling, in order, without dice. The formulas, outcomes and card read them as `@let.<name>`; each reads the ones before it.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "title": "Identifier"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "title": "Formula",
              "description": "A formula (specs §8.9)."
            }
          },
          "formula": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "title": "Formula",
                "description": "A formula (specs §8.9)."
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "title": "Identifier"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula",
                  "description": "A formula (specs §8.9)."
                },
                "title": "Named formulas"
              }
            ],
            "description": "What to roll: dice and `@` references to the entity's data, `@derived`, `@args` and `@settings`. Or several formulas by name, rolled in order into one message; each reads those before it as `@rolls.<name>`."
          },
          "outcomes": {
            "description": "Checked in order; the first whose `when` is true is shown.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "description": "A true/false formula that can read `@total`, `@roll`, `@rolls` and `@let`; leave it out for the fallback.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text",
                  "description": "Shown with the roll; a lang key or literal text."
                },
                "class": {
                  "description": "A CSS class for the outcome, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false,
              "title": "Outcome"
            }
          },
          "card": {
            "description": "A card in `cards/`, without `.json`, to show the roll with.",
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "title": "Name"
          },
          "item": {
            "description": "Item types the roll is made with. It is then rolled from an `items` row or an item’s sheet, and reads the item as `@item`.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "title": "Name"
            }
          },
          "actors": {
            "description": "The actor types that may roll it. The validator checks it against these only, sheets of other types cannot show its buttons, and the server refuses it for other actors.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "title": "Name"
            }
          }
        },
        "required": [
          "formula"
        ],
        "additionalProperties": false,
        "title": "Formula recipe"
      },
      {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text"
          },
          "handler": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "title": "Name",
            "description": "A handler in `code/server`, run on the server when the recipe is rolled."
          },
          "actors": {
            "description": "The actor types that may roll it. The validator checks it against these only, sheets of other types cannot show its buttons, and the server refuses it for other actors.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "title": "Name"
            }
          }
        },
        "required": [
          "handler"
        ],
        "additionalProperties": false,
        "title": "Handler recipe"
      }
    ]
  },
  "description": "Roll recipes for `rollButton` nodes, each under a name such as `skill` (letters, digits, `_` and `-`)."
}
