{
  "title": "Roll recipes (rolls.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "label": {
            "description": "The roll name in chat; a lang key or literal text.",
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text"
          },
          "let": {
            "description": "Named values worked out before rolling, in order, without dice. The formulas, outcomes and card read them as `@let.<name>`; each reads the ones before it.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "title": "Identifier"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "title": "Formula",
              "description": "A formula (specs §8.9)."
            }
          },
          "options": {
            "description": "What the app asks for when the button is pressed: a choice, a whole number or dice. Formulas, named values, outcomes and the card read them as `@options.<name>`; the server checks them.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "title": "Identifier"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "choice"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "title": "Text",
                      "description": "What the option asks; a lang key or literal text."
                    },
                    "choices": {
                      "minItems": 2,
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                            "title": "Identifier",
                            "description": "Read as `@options.<name>`, such as `'advantage'`."
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500,
                            "title": "Text",
                            "description": "A lang key or literal text."
                          },
                          "key": {
                            "description": "Holding this key while clicking the button picks this choice and rolls at once, with the other options at their defaults.",
                            "type": "string",
                            "enum": [
                              "shift",
                              "ctrl"
                            ]
                          }
                        },
                        "required": [
                          "value",
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "default": {
                      "description": "The value picked at first; the first when left out.",
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                      "title": "Identifier"
                    }
                  },
                  "required": [
                    "type",
                    "label",
                    "choices"
                  ],
                  "additionalProperties": false,
                  "title": "Choice option"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "number"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "title": "Text",
                      "description": "What the option asks; a lang key or literal text."
                    },
                    "default": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000,
                          "title": "Formula",
                          "description": "A formula (specs §8.9)."
                        }
                      ],
                      "description": "A whole number, or a formula such as `@item.level`."
                    },
                    "minimum": {
                      "description": "The lowest whole number allowed, or a formula.",
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000,
                          "title": "Formula",
                          "description": "A formula (specs §8.9)."
                        }
                      ]
                    },
                    "maximum": {
                      "description": "The highest whole number allowed, or a formula.",
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000,
                          "title": "Formula",
                          "description": "A formula (specs §8.9)."
                        }
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "label",
                    "default"
                  ],
                  "additionalProperties": false,
                  "title": "Number option"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "dice"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "title": "Text",
                      "description": "What the option asks; a lang key or literal text."
                    },
                    "default": {
                      "description": "Dice such as `1d4`, or nothing (the default).",
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "type",
                    "label"
                  ],
                  "additionalProperties": false,
                  "title": "Dice option"
                }
              ]
            }
          },
          "formula": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "title": "Formula",
                "description": "A formula (specs §8.9)."
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "title": "Identifier"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula",
                  "description": "A formula (specs §8.9)."
                },
                "title": "Named formulas"
              }
            ],
            "description": "What to roll: dice and `@` references to the entity's data, `@derived`, `@args` and `@settings`. Or several formulas by name, rolled in order into one message; each reads those before it as `@rolls.<name>`."
          },
          "outcomes": {
            "description": "Checked in order; the first whose `when` is true is shown.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "description": "A true/false formula that can read `@total`, `@roll`, `@rolls`, `@let` and `@options`; leave it out for the fallback.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "Formula"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "title": "Text",
                  "description": "Shown with the roll; a lang key or literal text."
                },
                "class": {
                  "description": "A CSS class for the outcome, for `styles/*.css`.",
                  "type": "string",
                  "maxLength": 200,
                  "title": "CSS classes"
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false,
              "title": "Outcome"
            }
          },
          "card": {
            "description": "A card in `cards/`, without `.json`, to show the roll with.",
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "title": "Name"
          },
          "item": {
            "description": "Item types the roll is made with. It is then rolled from an `items` row or an item’s sheet; formulas read the item as `@item`, and server code gets it as `item`.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "title": "Name"
            }
          },
          "target": {
            "description": "Actor types the roll may target: it then carries the tokens the roller targets. Its formulas, outcomes and card read the first target as `@target` (its fields, `derived`, `id`, `name` and `type`) and how many there are as `@targets`; `@target` exists only when `@targets > 0`.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "title": "Name"
            }
          },
          "then": {
            "description": "A handler in `code/server`, run after the roll is posted. It gets the result, the item and the options, and can step counters, such as spending a spell slot.",
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "title": "Name"
          },
          "actors": {
            "description": "The actor types that may roll it. The validator checks it against these only, sheets of other types cannot show its buttons, and the server refuses it for other actors.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "title": "Name"
            }
          }
        },
        "required": [
          "formula"
        ],
        "additionalProperties": false,
        "title": "Formula recipe"
      },
      {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text"
          },
          "handler": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "title": "Name",
            "description": "A handler in `code/server`, run on the server when the recipe is rolled."
          },
          "item": {
            "description": "Item types the roll is made with. It is then rolled from an `items` row or an item’s sheet; formulas read the item as `@item`, and server code gets it as `item`.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "title": "Name"
            }
          },
          "actors": {
            "description": "The actor types that may roll it. The validator checks it against these only, sheets of other types cannot show its buttons, and the server refuses it for other actors.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "title": "Name"
            }
          }
        },
        "required": [
          "handler"
        ],
        "additionalProperties": false,
        "title": "Handler recipe"
      }
    ]
  },
  "description": "Roll recipes for `rollButton` nodes, each under a name such as `skill` (letters, digits, `_` and `-`)."
}
