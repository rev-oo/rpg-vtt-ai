{
  "title": "Plugin settings (settings.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text",
            "description": "A lang key or literal text."
          },
          "description": {
            "description": "Help shown under the option.",
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text"
          },
          "scope": {
            "description": "Who sets the option: `table` (the default), the GM in table settings; `instance`, admins on the Plugins page, for every table; `user`, each member for themselves. Formulas read only `table` options.",
            "type": "string",
            "enum": [
              "instance",
              "table",
              "user"
            ]
          },
          "type": {
            "type": "string",
            "const": "boolean"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "type",
          "default"
        ],
        "additionalProperties": false,
        "description": "A checkbox."
      },
      {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text",
            "description": "A lang key or literal text."
          },
          "description": {
            "description": "Help shown under the option.",
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text"
          },
          "scope": {
            "description": "Who sets the option: `table` (the default), the GM in table settings; `instance`, admins on the Plugins page, for every table; `user`, each member for themselves. Formulas read only `table` options.",
            "type": "string",
            "enum": [
              "instance",
              "table",
              "user"
            ]
          },
          "type": {
            "type": "string",
            "const": "integer"
          },
          "default": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "minimum": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "maximum": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "label",
          "type",
          "default"
        ],
        "additionalProperties": false,
        "description": "A whole number."
      },
      {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text",
            "description": "A lang key or literal text."
          },
          "description": {
            "description": "Help shown under the option.",
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text"
          },
          "scope": {
            "description": "Who sets the option: `table` (the default), the GM in table settings; `instance`, admins on the Plugins page, for every table; `user`, each member for themselves. Formulas read only `table` options.",
            "type": "string",
            "enum": [
              "instance",
              "table",
              "user"
            ]
          },
          "type": {
            "type": "string",
            "const": "number"
          },
          "default": {
            "type": "number"
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "type",
          "default"
        ],
        "additionalProperties": false,
        "description": "A number."
      },
      {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text",
            "description": "A lang key or literal text."
          },
          "description": {
            "description": "Help shown under the option.",
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "title": "Text"
          },
          "scope": {
            "description": "Who sets the option: `table` (the default), the GM in table settings; `instance`, admins on the Plugins page, for every table; `user`, each member for themselves. Formulas read only `table` options.",
            "type": "string",
            "enum": [
              "instance",
              "table",
              "user"
            ]
          },
          "type": {
            "type": "string",
            "const": "string"
          },
          "default": {
            "type": "string"
          },
          "enum": {
            "description": "Offers these values to pick from.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enumLabels": {
            "description": "What the form shows for each `enum` value: a lang key or text, by value. The stored value stays the plain value.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "title": "Text"
            }
          },
          "format": {
            "description": "A colour, written `#rrggbb` and picked with a colour picker; it cannot have an `enum`.",
            "type": "string",
            "const": "colour"
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "label",
          "type",
          "default"
        ],
        "additionalProperties": false,
        "description": "Text, a choice with `enum`, or a colour with `format`."
