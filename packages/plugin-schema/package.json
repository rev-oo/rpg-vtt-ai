{
  "name": "@vtt/plugin-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/src",
    "schemas"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./issues": {
      "types": "./dist/src/validate/issues.d.ts",
      "default": "./dist/src/validate/issues.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "dependencies": {
    "@vtt/formula": "workspace:*",
    "@vtt/shared": "workspace:*",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "^4.2.0",
    "semver": "^7.8.5",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.node.json && node dist/scripts/emit-schemas.js",
    "typecheck": "tsc -b tsconfig.json tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "@vtt/config": "workspace:*",
    "ajv": "^8.20.0"
  }
}
