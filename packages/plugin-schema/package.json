{
  "name": "@vtt/plugin-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "dependencies": {
    "@vtt/formula": "workspace:*",
    "@vtt/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.node.json && node dist/scripts/emit-schemas.js",
    "typecheck": "tsc -b tsconfig.json tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@vtt/config": "workspace:*",
    "ajv": "^8.20.0"
  }
}
