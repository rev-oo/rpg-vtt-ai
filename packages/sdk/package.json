{
  "name": "@vtt/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "default": "./dist/src/client/index.js"
    }
  },
  "dependencies": {
    "@vtt/shared": "workspace:*",
    "@vtt/formula": "workspace:*",
    "@vtt/plugin-schema": "workspace:*",
    "@vtt/plugin-engine": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.client.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.client.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vtt/config": "workspace:*",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
