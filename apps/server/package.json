{
  "name": "@vtt/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@node-rs/argon2": "^2.2.2",
    "@vtt/formula": "workspace:*",
    "@vtt/plugin-engine": "workspace:*",
    "@vtt/plugin-schema": "workspace:*",
    "@vtt/sdk": "workspace:*",
